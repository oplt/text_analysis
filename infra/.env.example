POSTGRES_USER=text_analysis
POSTGRES_PASSWORD=text_analysis
POSTGRES_DB=text_analysis
JWT_SECRET=replace-with-a-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BUCKET=app-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=change-this-storage-access-key
STORAGE_SECRET_KEY=change-this-storage-secret-key
STORAGE_USE_SSL=false
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true
MINIO_ROOT_USER=change-this-storage-access-key
MINIO_ROOT_PASSWORD=change-this-storage-secret-key

# Optional R worker profile (`docker compose --profile r up worker-r`).
# Container/cgroup limits are the enforceable isolation boundary; keep defaults
# conservative. CELERY_R_CONCURRENCY should stay at 1 unless memory headroom is proven.
RESEARCH_R_ENABLED=false
RESEARCH_QUEUE_R=research_r
CELERY_R_CONCURRENCY=1
WORKER_R_MEMORY_LIMIT=4g
WORKER_R_CPUS=2.0
WORKER_R_PIDS_LIMIT=256
